{
  "name": "@northskysocial/migration-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:test": "react-router dev --mode test",
    "start": "react-router-serve ./build/server/index.js",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx}\"",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx}\"",
    "lint": "oxlint .",
    "prepare": "test ! -e .git || husky",
    "test:env": "tsx bin/testenv.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "test:unit": "vitest run test/unit",
    "test:coverage": "vitest run --coverage test/unit",
    "test:unit:watch": "vitest test/unit",
    "test:backend": "docker pull ghcr.io/northskysocial/pds-migration:main && docker run -it northskysocial/pds-migration:main",
    "test:backend-arm64": "cargo run --bin pdsmigration-web --manifest-path pds-migration/Cargo.toml",
    "test": "npx concurrently -i --kill-others npm:test:env npm:dev:test npm:test:backend",
    "test:arm64": "npx concurrently -i --kill-others npm:test:env npm:dev:test npm:test:backend-arm64",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@1password/save-button": "^1.3.0",
    "@atproto/api": "^0.28.1",
    "@chakra-ui/react": "^3.34.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/museomoderno": "^5.2.9",
    "@NorthskySocial/northwoods-ui": "^0.1.2",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@scure/bip39": "^2.0.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "check-password-strength": "^3.0.0",
    "ioredis": "^6.0.0",
    "isbot": "^5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "react-server-dom-webpack": "^19.3.1",
    "use-debounce": "^10.0.6"
  },
  "devDependencies": {
    "@atproto/dev-env": "^0.6.24",
    "@react-router/dev": "^8.5.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "inquirer": "^14.2.4",
    "lint-staged": "^17.6.0",
    "niceware": "^4.0.0",
    "nodemailer": "^10.1.7",
    "oxlint": "1.89.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.js": "oxlint --cache --fix",
    "*.{js,ts,jsx,tsx}": "prettier --write"
  }
}
